{
  "name": "noteflow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "android:native": "expo run:android",
    "android:device": "expo run:android --device",
    "android:debug:auto": "powershell -ExecutionPolicy Bypass -File ./scripts/android-debug-launch.ps1",
    "android:debug:auto:noinstall": "powershell -ExecutionPolicy Bypass -File ./scripts/android-debug-launch.ps1 -SkipInstall",
    "android:debug:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/android-debug-doctor.ps1",
    "android:debug:prepare": "powershell -ExecutionPolicy Bypass -File ./scripts/android-debug-prepare.ps1",
    "android:debug:install": "powershell -ExecutionPolicy Bypass -File ./scripts/android-debug-prepare.ps1 -InstallApp",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-paper": "^5.15.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  },
  "private": true
}
